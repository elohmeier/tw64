diff --git a/src/base/detect.h b/src/base/detect.h
index 2028f5a..3221bc0 100644
--- a/src/base/detect.h
+++ b/src/base/detect.h
@@ -85,0 +86,12 @@
+/* nintendo 64 (libdragon/newlib) */
+#if defined(CONF_PLATFORM_N64)
+	/* newlib ships no <endian.h> and detect.h has no MIPS entry, but the
+	   target is a fixed big-endian VR4300, so state it directly. Defined
+	   only by the ROM build; host builds are unaffected. */
+	#define CONF_FAMILY_STRING "n64"
+	#define CONF_PLATFORM_STRING "n64"
+	#define CONF_ARCH_MIPS64 1
+	#define CONF_ARCH_STRING "mips64"
+	#define CONF_ARCH_ENDIAN_BIG 1
+#endif
+
@@ -87 +99 @@
-#if defined(__GNUC__) && !defined(__APPLE__) && !defined(__MINGW32__) && !defined(__sun)
+#if defined(__GNUC__) && !defined(CONF_PLATFORM_N64) && !defined(__APPLE__) && !defined(__MINGW32__) && !defined(__sun)
diff --git a/src/base/vmath.h b/src/base/vmath.h
index 300189a..8d5ba05 100644
--- a/src/base/vmath.h
+++ b/src/base/vmath.h
@@ -70,0 +71,4 @@
+	// A point segment has no direction. Returning its only point is the
+	// geometric answer and avoids feeding normalize() a zero vector.
+	if(line_point0 == line_point1)
+		return line_point0;
